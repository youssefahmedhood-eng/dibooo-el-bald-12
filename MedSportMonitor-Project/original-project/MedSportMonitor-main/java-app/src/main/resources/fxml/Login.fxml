<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.medsport.auth.LoginController"
           fx:id="rootPane"
           prefWidth="1100" prefHeight="720"
           styleClass="login-root">
    <Pane styleClass="login-bg" maxWidth="Infinity" maxHeight="Infinity"/>
    <VBox styleClass="login-card" spacing="0" alignment="TOP_CENTER"
          maxWidth="420" maxHeight="580">
        <VBox alignment="CENTER" spacing="6">
            <VBox.margin><Insets bottom="32"/></VBox.margin>
            <Label text="+" style="-fx-font-size:48px; -fx-text-fill:-theme-accent; -fx-font-weight:bold;"/>
            <Label text="MedSport Monitor" styleClass="login-brand"/>
            <Label text="PERFORMANCE HEALTH PLATFORM" styleClass="login-brand-sub"/>
        </VBox>
        <VBox spacing="12">
            <TextField fx:id="emailField" promptText="Email address" maxWidth="Infinity"/>
            <PasswordField fx:id="passwordField" promptText="Password" maxWidth="Infinity"/>
        </VBox>
        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true"
               maxWidth="Infinity" visible="false" managed="false">
            <VBox.margin><Insets top="12"/></VBox.margin>
        </Label>
        <ProgressIndicator fx:id="spinner" visible="false" managed="false"
                           maxWidth="28" maxHeight="28">
            <VBox.margin><Insets top="8"/></VBox.margin>
        </ProgressIndicator>
        <Button fx:id="loginButton" text="Sign In" onAction="#handleLogin"
                styleClass="btn-primary" maxWidth="Infinity">
            <VBox.margin><Insets top="20"/></VBox.margin>
        </Button>
        <HBox alignment="CENTER" spacing="12">
            <VBox.margin><Insets top="16" bottom="16"/></VBox.margin>
            <Region HBox.hgrow="ALWAYS" style="-fx-background-color:#30363d; -fx-pref-height:1px;"/>
            <Label text="or" styleClass="caption"/>
            <Region HBox.hgrow="ALWAYS" style="-fx-background-color:#30363d; -fx-pref-height:1px;"/>
        </HBox>
        <VBox alignment="CENTER" spacing="4">
            <Label text="Don't have an account?" styleClass="caption"/>
            <Button fx:id="registerButton" text="Create account" onAction="#handleRegister"
                    styleClass="btn-link"/>
        </VBox>
        <Label text="v1.0.0  |  Secure connection" styleClass="caption"
               style="-fx-font-size:10px; -fx-opacity:0.5;">
            <VBox.margin><Insets top="24"/></VBox.margin>
        </Label>
    </VBox>
</StackPane>