<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.medsport.controllers.medical.ReportsController"
            style="-fx-background-color:#0d1117;">
  <VBox spacing="20" style="-fx-padding:24; -fx-background-color:#0d1117;">

    <HBox alignment="CENTER_LEFT" spacing="16">
      <Label text="Reports &amp; Exports" style="-fx-font-size:22px;-fx-font-weight:bold;-fx-text-fill:#e6edf3;"/>
      <Region HBox.hgrow="ALWAYS"/>
      <Label fx:id="apiStatusLabel" text="● API Offline"
             style="-fx-text-fill:#f85149;-fx-font-weight:bold;-fx-font-size:12px;"/>
      <Button text="↻" onAction="#handleRefreshApi"
              styleClass="btn-ghost" style="-fx-padding:4 10 4 10;"/>
    </HBox>

    <!-- Report configuration -->
    <VBox styleClass="glass-card" spacing="14" style="-fx-padding:20;">
      <Label text="Generate Report" style="-fx-font-size:14px;-fx-font-weight:bold;-fx-text-fill:#e6edf3;"/>

      <GridPane hgap="16" vgap="12">
        <Label text="Athlete / Scope" GridPane.rowIndex="0" GridPane.columnIndex="0"
               style="-fx-text-fill:#8b949e;-fx-font-size:13px;"/>
        <ComboBox fx:id="athleteCombo" prefWidth="220"
                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Report Type" GridPane.rowIndex="1" GridPane.columnIndex="0"
               style="-fx-text-fill:#8b949e;-fx-font-size:13px;"/>
        <ComboBox fx:id="reportTypeCombo" prefWidth="220"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="From" GridPane.rowIndex="2" GridPane.columnIndex="0"
               style="-fx-text-fill:#8b949e;-fx-font-size:13px;"/>
        <DatePicker fx:id="fromDatePicker" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="To" GridPane.rowIndex="3" GridPane.columnIndex="0"
               style="-fx-text-fill:#8b949e;-fx-font-size:13px;"/>
        <DatePicker fx:id="toDatePicker" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
      </GridPane>

      <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="generateBtn" text="Generate PDF" onAction="#handleGenerate"
                styleClass="btn-primary" style="-fx-padding:8 24 8 24;"/>
        <ProgressBar fx:id="generateProgress" prefWidth="160" visible="false" managed="false"/>
        <Label fx:id="statusLabel" text="" visible="false" managed="false"
               style="-fx-font-size:12px;"/>
      </HBox>
    </VBox>

    <!-- Recent reports -->
    <Label text="Recent Reports" style="-fx-font-size:14px;-fx-font-weight:bold;-fx-text-fill:#8b949e;"/>
    <VBox fx:id="recentReportsList" spacing="6"
          style="-fx-background-color:transparent;"/>

  </VBox>
</ScrollPane>