<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.canvas.*?>
<?import javafx.geometry.*?>
<ScrollPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.medsport.controllers.athlete.PerformanceController"
            fitToWidth="true" hbarPolicy="NEVER"
            style="-fx-background:transparent; -fx-background-color:transparent;">
  <VBox spacing="20" style="-fx-padding:24 32;">
    <HBox alignment="CENTER_LEFT" spacing="12">
      <Label text="Performance" styleClass="page-title" style="-fx-padding:0;"/>
      <Region HBox.hgrow="ALWAYS"/>
      <Button text="Refresh" onAction="#handleRefresh" styleClass="btn-secondary"/>
    </HBox>

    <HBox spacing="16">
      <!-- Radar chart -->
      <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS">
        <Label text="Performance Radar" styleClass="section-title"/>
        <Canvas fx:id="radarCanvas" width="380" height="340"/>
      </VBox>

      <!-- Stats + records -->
      <VBox spacing="16" HBox.hgrow="ALWAYS">
        <!-- Summary stats -->
        <VBox styleClass="card" spacing="12">
          <Label text="Last 30 Days" styleClass="section-title"/>
          <HBox spacing="24">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
              <Label text="Avg HR"       styleClass="caption"/>
              <Label fx:id="avgHrLabel"  text="—" styleClass="value-unit" style="-fx-font-size:18px; -fx-text-fill:#e6edf3;"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
              <Label text="Max HR"       styleClass="caption"/>
              <Label fx:id="maxHrLabel"  text="—" styleClass="value-unit" style="-fx-font-size:18px; -fx-text-fill:#e6edf3;"/>
            </VBox>
          </HBox>
          <HBox spacing="24">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
              <Label text="Avg SpO2"       styleClass="caption"/>
              <Label fx:id="avgSpo2Label"  text="—" styleClass="value-unit" style="-fx-font-size:18px; -fx-text-fill:#e6edf3;"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
              <Label text="Avg Speed"         styleClass="caption"/>
              <Label fx:id="avgSpeedLabel"    text="—" styleClass="value-unit" style="-fx-font-size:18px; -fx-text-fill:#e6edf3;"/>
            </VBox>
          </HBox>
          <HBox spacing="24">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
              <Label text="Total Distance"   styleClass="caption"/>
              <Label fx:id="totalDistLabel"  text="—" styleClass="value-unit" style="-fx-font-size:18px; -fx-text-fill:#e6edf3;"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
              <Label text="Training Load"       styleClass="caption"/>
              <Label fx:id="trainingLoadLabel"  text="—" styleClass="value-unit" style="-fx-font-size:18px; -fx-text-fill:#e6edf3;"/>
            </VBox>
          </HBox>
        </VBox>

        <!-- Personal records -->
        <VBox styleClass="card" spacing="8" VBox.vgrow="ALWAYS">
          <Label text="Personal Records" styleClass="section-title"/>
          <ListView fx:id="recordsList" VBox.vgrow="ALWAYS"
                    style="-fx-background-color:transparent; -fx-border-width:0;"/>
        </VBox>
      </VBox>
    </HBox>
  </VBox>
</ScrollPane>